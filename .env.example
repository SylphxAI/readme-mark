PORT=8787
HOST=0.0.0.0
RUST_LOG=mark=info,tower_http=info
PUBLIC_BASE_URL=https://mark.sylphx.com
DEFAULT_CREDIT=0
# Optional server token(s) for live GitHub cards (raises rate limits; never a
# user token). Unset = anonymous REST + the public contributions calendar.
# GITHUB_TOKEN=
# GITHUB_TOKENS=token_a,token_b

# Upstream loads (cache misses) one client may cause per minute; over it the
# client gets cached or fallback cards. Cached responses are never limited.
# LIVE_CLIENT_FETCHES_PER_MIN=300
